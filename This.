const express = require('express');
const app = express();

app.use(express.json());

app.post('/registro', (req, res) => {

  const nombre = req.body.nombre;
  const mensaje = req.body.mensaje;

  res.json({
    estado: "Datos recibidos",
    nombre: nombre,
    mensaje: mensaje
  });

});

app.post('/incidencia', (req, res) => {

  const tipo = req.body.tipo;
  const descripcion = req.body.descripcion;

  res.json({
    mensaje: "Incidencia registrada",
    tipo: tipo,
    descripcion: descripcion
  });

});

app.listen(3000, () => {
  console.log('Servidor ejecutándose en puerto 3000');
});



Pregunta 1: Un formato de intercambio de datos usado entre aplicaciones.

Pregunta 2: Leer datos enviados en formato JSON en una petición.

Pregunta 3: req.body.

Pregunta 4: { "nombre": "Juan" }.

El servidor recibe los datos enviados mediante una petición POST y responde con un mensaje indicando que los datos fueron recibidos correctamente, mostrando el nombre y el mensaje enviados.

{
  "tipo": "Iluminación pública",
  "descripcion": "La comunidad reporta que una lámpara del parque no funciona desde hace varios días."
}

Es importante que las plataformas tecnológicas reciban información de forma estructurada porque permite organizar mejor los datos enviados por los ciudadanos. Esto facilita el registro de reportes y la atención de las necesidades de la comunidad. Además, ayuda a mantener la información clara, ordenada y útil para dar seguimiento a cada caso.

  
